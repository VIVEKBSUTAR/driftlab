            "type": "array",
            "title": "Verdicts"
          },
          "recommendation": {
            "type": "string",
            "enum": [
              "block",
              "review",
              "within_policy"
            ],
            "title": "Recommendation"
          },
          "config": {
            "additionalProperties": true,
            "type": "object",
            "title": "Config"
          },
          "baseline": {
            "$ref": "#/components/schemas/RunSummary"
          },
          "candidate": {
            "$ref": "#/components/schemas/RunSummary"
          }
        },
        "type": "object",
        "required": [
          "id",
          "baseline_run_id",
          "candidate_run_id",
          "created_at",
          "verdicts",
          "recommendation",
          "config",
          "baseline",
          "candidate"
        ],
        "title": "ComparisonResponse"
      },
