        "additionalProperties": false,
        "type": "object",
        "required": [
          "baseline_run_id",
          "candidate_run_id"
        ],
        "title": "CompareRequest"
      },
      "ComparisonResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
