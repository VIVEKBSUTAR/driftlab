# Copy to .env (ignored by Git), chmod 600 .env, then supply your own values.
# Generate DRIFTLAB_API_KEY with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DRIFTLAB_API_KEY=
DRIFTLAB_DOMAIN=driftlab.example.com
DRIFTLAB_ALLOWED_HOSTS=driftlab.example.com,localhost,127.0.0.1
DRIFTLAB_ALLOWED_ORIGINS=https://driftlab.example.com
DRIFTLAB_OLLAMA_URL=http://host.docker.internal:11434
